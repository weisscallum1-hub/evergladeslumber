{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evergladeslumber",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "elx-leads",
      "database_id": "8a44bd2a-374e-44ac-ad56-4abe430bd888"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFhSDoJJj7-cXSv0"
  },
  "ratelimits": [
    {
      "name": "SCOUT_LIMITER",
      "namespace_id": "2026102201",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "INTAKE_LIMITER",
      "namespace_id": "2026102202",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./Site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
